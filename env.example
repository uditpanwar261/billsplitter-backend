# ── BillSplitter Backend — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────────
# Local MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost/billsplitter
# Railway MySQL (auto-injected by Railway — no need to set manually):
# DATABASE_URL=mysql://user:pass@host:port/dbname
# SQLite fallback (leave DATABASE_URL blank for zero-config dev):
# DATABASE_URL=

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production:
CORS_ORIGINS=*
# Example: CORS_ORIGINS=https://billsplitter.vercel.app

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
